		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="8397fb83-662e-4f9f-92cc-cbab02d3ca1c" >
				<munit:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;&#10;{&#10;   "passengers": 50,&#10;   "cargoWeight": 100000,&#10;   "requiresHyperdrive": true&#10;}]' encoding="UTF-8" mediaType="application/json" />
				<munit:attributes value='#[{headers: {"client_id": "123", "client_secret": "2345", "X-Correlation-Id": "23456"}}]' />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post-starhip-readinessFlow" doc:id="808caed9-8608-4002-9d03-d64fc25fe91e" name="post-starhip-readinessFlow" />
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="7dd67589-975b-4443-bcf5-4c946b2d3c91" actual="#[vars.httpStatus]" expected='#["200"]' />
		</munit:validation>
	</munit:test>


</mule>
