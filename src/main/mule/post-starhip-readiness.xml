<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="post-starhip-readinessFlow" doc:id="dda477a3-62df-44b0-9471-9e212ba09ac7" >
		<set-variable value="#[attributes.headers.'X-Correlation-Id' default correlationId]" doc:name="correlationId" doc:id="b5457393-3520-44d6-aa59-72b1b824b001" variableName="correlationId"/>
		<logger level="INFO" doc:name="Received Mission Request" doc:id="8ce7ddf2-bfcc-433d-af64-d07535c3581e" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	&#10;payload: payload,&#10;correlationId: vars.correlationId&#10;&#10;}]'/>
		<set-variable value="#[payload]" doc:name="MissionCriteria" doc:id="3536acea-6078-4b8d-b779-d9891f4b8da2" variableName="missionCriteria"/>
		<http:request doc:name="Retrieve Starships from SWAPI" doc:id="66312491-25c8-4192-ada5-62f088a0d0f8" config-ref="HTTP_Request_config" method="GET" url="https://swapi.dev/api/starships"/>
		<choice doc:name="Response Validation" doc:id="da115866-6f5b-43da-b9f5-67eea9b346b1" >
			<when expression="#[isEmpty(payload)==true]">
				<ee:transform doc:name="No Ships Support" doc:id="a923c8ad-c0b3-48fe-b4bf-7f8ad0c7de83" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "missionSupported": false,
  "message": "No starships satisfy the supplied mission parameters.",
  "matchingShips": []
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="outboundHeaders" ><![CDATA[%dw 2.0
output application/java
---
(vars.outboundHeaders default {}) ++
{
    "X-Correlation-ID": vars.correlationId
}]]></ee:set-variable>
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
"200"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise >
			<ee:transform doc:name="Normalize Starships Response" doc:id="61263a6c-c94f-49bd-b687-43effcc5f32e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import * from dw::core::Strings
fun toNumber(value) =
    if (
        value == null or
        value == "unknown" or
        value == "n/a" or
        value == "none"
    )
        0
    else
        (value replace "," with "") as Number
---
payload.results map (ship) -> {
    name: ship.name,
    model: ship.model,
    starshipClass: ship.starship_class,
    maxCargoWeight: toNumber(ship.cargo_capacity),
    maxCrew: if (ship.crew contains "-")
        substringAfter(ship.crew, "-")
    else ship.crew,
    maxPassengers: toNumber(ship.passengers),
    hyperdriveRating: toNumber(ship.hyperdrive_rating)
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
			</ee:variables>
		</ee:transform>
		<choice doc:name="HyperDrive Required" doc:id="1ad8e81f-9820-4348-a4da-5549ca5b3076" >
			<when expression="#[vars.missionCriteria.requiresHyperdrive==true]">
				<ee:transform doc:name="Prepare Response" doc:id="cfd84b45-180c-40fb-819a-d54e9f72f734">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var matchingShips =
    payload filter (ship) ->

        ship.maxPassengers >= vars.missionCriteria.passengers

        and

        (
            vars.missionCriteria.cargoWeight == null
            or
            ship.maxCargoWeight >= vars.missionCriteria.cargoWeight
        )

        and

        (
            !vars.missionCriteria.requiresHyperdrive
            or ship.hyperdriveRating <= 2
        )
---
{
	 missionSupported: !isEmpty(matchingShips),

    message:
        if (isEmpty(matchingShips))
            "No starships satisfy the supplied mission requirements."
        else
            sizeOf(matchingShips) ++ " starship(s) satisfy the mission requirements.",

    matchingShips: matchingShips
}]]></ee:set-payload>
			</ee:message>
							<ee:variables >
								<ee:set-variable variableName="outboundHeaders" ><![CDATA[%dw 2.0
output application/java
---
(vars.outboundHeaders default {}) ++
{
    "X-Correlation-ID": vars.correlationId
}]]></ee:set-variable>
								<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
"200"]]></ee:set-variable>
							</ee:variables>
		
</ee:transform>
			</when>
			<otherwise >
				<ee:transform doc:name="Prepare Response" doc:id="a208da92-58bc-467b-a05b-1c7743e5d744" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var matchingShips =
    payload filter (ship) ->

        ship.maxPassengers >= vars.missionCriteria.passengers

        and

        (
            vars.missionCriteria.cargoWeight == null
            or
            ship.maxCargoWeight >= vars.missionCriteria.cargoWeight
        )

        and

        (
            !vars.missionCriteria.requiresHyperdrive
            or ship.hyperdriveRating
        )
---
{
	 missionSupported: !isEmpty(matchingShips),

    message:
        if (isEmpty(matchingShips))
            "No starships satisfy the supplied mission requirements."
        else
            sizeOf(matchingShips) ++ " starship(s) satisfy the mission requirements.",

    matchingShips: matchingShips
}]]></ee:set-payload>
					</ee:message>
							<ee:variables >
								<ee:set-variable variableName="outboundHeaders" ><![CDATA[%dw 2.0
output application/java
---
(vars.outboundHeaders default {}) ++
{
    "X-Correlation-ID": vars.correlationId
}]]></ee:set-variable>
								<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
"200"]]></ee:set-variable>
							</ee:variables>
				
</ee:transform>
			</otherwise>
		</choice>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="End Logger" doc:id="3476c8f2-f80a-41af-8a1e-39109991cf04" message="#[payload]"/>
		<error-handler>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="17ab63cf-df80-496c-8b2f-866a894e5100" type="ANY">
				<ee:transform doc:name="Transform Message" doc:id="75ca0189-b3e3-4154-84e8-25026a6c96f7" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
error.detailedDescription]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
